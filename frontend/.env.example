# Frontend Environment Variables

# API Base URL (defaults to /api, proxied by Vite to backend)
# In production, set this to your backend URL
VITE_API_URL=/api

# WebSocket URL for Claude chat
# In development, proxied by Vite to ws://localhost:3000
# In production, set this to your WebSocket server URL
VITE_WS_URL=ws://localhost:3000/claude-chat
